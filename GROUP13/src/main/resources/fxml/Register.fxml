<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group13.greengrocer.controllers.RegisterController"
      styleClass="login-container">
    <padding>
        <Insets top="30" right="50" bottom="30" left="50"/>
    </padding>

    <Label text="Create Account" styleClass="title-label"/>

    <VBox spacing="10" alignment="CENTER" maxWidth="350">
        <TextField fx:id="usernameField" promptText="Username"/>
        <PasswordField fx:id="passwordField" promptText="Password"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password"/>
        <TextField fx:id="fullNameField" promptText="Full Name"/>
        <TextField fx:id="emailField" promptText="Email (optional)"/>
        <TextField fx:id="phoneField" promptText="Phone (optional)"/>
        <TextArea fx:id="addressField" promptText="Address" prefRowCount="2"/>
        
        <Button text="Register" onAction="#handleRegister" styleClass="primary-button" maxWidth="Infinity"/>
        <Button text="Back to Login" onAction="#handleBackToLogin" styleClass="secondary-button" maxWidth="Infinity"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="error-label"/>
</VBox>
