<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group13.greengrocer.controllers.LoginController"
      styleClass="login-container">
    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <Label text="GreenGrocer" styleClass="title-label"/>
    <Label text="Login to your account" styleClass="subtitle-label"/>

    <VBox spacing="10" alignment="CENTER" maxWidth="300">
        <TextField fx:id="usernameField" promptText="Username" styleClass="text-field"/>
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="text-field"/>
        
        <Button text="Login" onAction="#handleLogin" styleClass="primary-button" maxWidth="Infinity"/>
        <Button text="Register" onAction="#handleRegister" styleClass="secondary-button" maxWidth="Infinity"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="error-label"/>
</VBox>
