<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group13.greengrocer.controllers.CustomerController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="header">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            <Label fx:id="welcomeLabel" text="Welcome" styleClass="header-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cart" onAction="#openCart"/>
            <Button text="Profile" onAction="#openProfile"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabPane">
            <Tab text="Products" closable="false">
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <HBox spacing="10">
                        <TextField fx:id="searchField" promptText="Search products..." HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="typeFilter" promptText="Filter by type"/>
                    </HBox>
                    <ListView fx:id="productList" VBox.vgrow="ALWAYS"/>
                </VBox>
            </Tab>
            <Tab text="My Orders" closable="false">
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="orderIdCol" text="Order ID" prefWidth="80"/>
                            <TableColumn fx:id="orderDateCol" text="Date" prefWidth="150"/>
                            <TableColumn fx:id="orderStatusCol" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="orderTotalCol" text="Total" prefWidth="100"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10">
                        <Button text="View Details" onAction="#viewOrderDetails"/>
                        <Button text="Cancel Order" onAction="#cancelOrder"/>
                        <Button text="Rate Carrier" onAction="#rateCarrier"/>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="Messages" closable="false">
                <VBox spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <ListView fx:id="messageList" VBox.vgrow="ALWAYS"/>
                    <TextArea fx:id="newMessageArea" promptText="Type your message..." prefRowCount="3"/>
                    <Button text="Send Message" onAction="#sendMessage"/>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>